{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/prisma.mjs generate --no-hints > /dev/null && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:setup": "node scripts/link-env.mjs && node scripts/prisma.mjs db push && npm run db:seed",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "node scripts/link-env.mjs && tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "node scripts/prisma.mjs studio",
    "postinstall": "node scripts/prisma.mjs generate --no-hints",
    "predev": "node scripts/link-env.mjs",
    "prebuild": "node scripts/link-env.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^14.11.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
