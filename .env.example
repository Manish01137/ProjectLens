# ProjectLens environment. Copy to `.env` in the repo root (`npm run setup` does this for you
# and fills in random secrets). Both the website (web/) and the ML service (ml_service/) read this file.

# ── Website ────────────────────────────────────────────────────────────────────────────
# Database. SQLite for development (path is relative to web/prisma/).
# For deployment use PostgreSQL, e.g. postgresql://user:pass@host/db?sslmode=require (Neon / Supabase).
DATABASE_URL="file:./dev.db"

# Auth.js secret, required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional "Continue with Google". The button only appears when both are set.
# Redirect URI to register in Google Cloud: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Where the website reaches the ML service. Server-side only, never sent to the browser.
ML_API_URL="http://localhost:8000"
# How long the chat waits for /generate (model 3 writing new ideas) before falling back to
# catalogue projects from /recommend. qwen2.5:3b on a laptop CPU can need 60-120 s.
ML_GENERATE_TIMEOUT_MS="60000"

# ── Assistant language model ───────────────────────────────────────────────────────────
# ollama (default) | anthropic | openai | gemini | none (polite templates only)
LLM_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Only the key for the provider you choose is needed. Model names can be overridden.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ── ML service ─────────────────────────────────────────────────────────────────────────
# Protects POST /admin/reload-model. Generate with: openssl rand -hex 24
ML_ADMIN_TOKEN=""

# Google Drive file ID of projectlens_retriever.zip (from its share link .../file/d/<ID>/view)
MODEL_DRIVE_FILE_ID="1llz0vhcPFQUgrrVRBm2vJl1de5-cT1zt"

# Optional. Path to a service-account JSON key (relative to the repo root or absolute).
# Set it to keep the Drive file private; leave empty to download via an "Anyone with the link" share.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Set to 1 to never contact Drive and only use the files already in ml_service/artifacts/.
SKIP_MODEL_DOWNLOAD=""

# Model 1 (intent classifier, DistilBERT). File ID of MyDrive/ProjectLens/projectlens_intent.zip,
# shared "Anyone with the link". Installed into ml_service/artifacts/projectlens_intent/ on start.
INTENT_DRIVE_FILE_ID=""
# Set to 1 to start without the intent model (/intent answers 501, the website uses its rules).
SKIP_INTENT_MODEL=""

# Model 3 (/generate): an idea is rejected as a copy when its cosine similarity to any catalogue
# project is at or above this value.
NOVELTY_MAX="0.85"

# Comma-separated origins allowed to call the ML service from a browser (CORS).
ALLOWED_ORIGINS="http://localhost:3000"
