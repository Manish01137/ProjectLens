{
  "name": "projectlens",
  "private": true,
  "description": "ProjectLens: discovering projects that truly fit",
  "workspaces": ["web"],
  "engines": { "node": ">=20.9" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others-on-fail --names ml,web,ready --prefix-colors yellow,cyan,green \"npm:dev:ml\" \"npm:dev:web\" \"node scripts/wait-ready.mjs\"",
    "dev:ml": "node scripts/ml.mjs serve",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "lint": "npm --workspace web run lint",
    "typecheck": "npm --workspace web run typecheck",
    "test": "npm --workspace web run test && npm run test:ml",
    "test:ml": "node scripts/ml.mjs test",
    "e2e": "npm --workspace web run e2e",
    "model:download": "node scripts/ml.mjs download"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
